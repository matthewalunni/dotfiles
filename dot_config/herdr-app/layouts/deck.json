{
  "id": "root",
  "type": "column",
  "theme": "earthcode-moss",
  "font": "JetBrains Mono",
  "ui_font": "JetBrains Mono",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "raised"
  },
  "children": [
    {
      "id": "deck-bar",
      "type": "block",
      "size": {
        "px": 44
      },
      "window_drag": true,
      "content": {
        "mod": "deck",
        "props": {
          "view": "bar"
        }
      }
    },
    {
      "id": "deck-main",
      "type": "stack",
      "active": "deck-chat",
      "children": [
        {
          "id": "deck-chat",
          "type": "row",
          "resizable": false,
          "divider": {
            "width": 1,
            "color": "raised"
          },
          "children": [
            {
              "id": "deck-chat-side",
              "type": "column",
              "size": {
                "px": 268
              },
              "background": "chrome",
              "resizable": false,
              "children": [
                {
                  "id": "deck-chat-spaces",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "spaces"
                  }
                },
                {
                  "id": "deck-chat-machines",
                  "type": "block",
                  "size": {
                    "px": 120
                  },
                  "content": {
                    "mod": "deck",
                    "props": {
                      "view": "machines"
                    }
                  }
                },
                {
                  "id": "deck-chat-agents",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "agents"
                  }
                },
                {
                  "id": "deck-chat-hints",
                  "type": "block",
                  "size": {
                    "px": 52
                  },
                  "content": {
                    "mod": "deck",
                    "props": {
                      "view": "termhints"
                    }
                  }
                }
              ]
            },
            {
              "id": "deck-chat-main",
              "type": "block",
              "content": {
                "mod": "deck",
                "props": {
                  "view": "chat"
                }
              }
            }
          ]
        },
        {
          "id": "deck-issues",
          "type": "block",
          "content": {
            "mod": "deck",
            "props": {
              "view": "issues"
            }
          }
        },
        {
          "id": "deck-issue",
          "type": "column",
          "resizable": false,
          "children": [
            {
              "id": "deck-issue-row",
              "type": "row",
              "resizable": false,
              "divider": {
                "width": 1,
                "color": "raised"
              },
              "children": [
                {
                  "id": "deck-issue-overview",
                  "type": "block",
                  "size": {
                    "px": 540
                  },
                  "content": {
                    "mod": "deck",
                    "props": {
                      "view": "issue"
                    }
                  }
                },
                {
                  "id": "deck-issue-side",
                  "type": "stack",
                  "active": "deck-issue-pane",
                  "children": [
                    {
                      "id": "deck-issue-pane",
                      "type": "column",
                      "resizable": false,
                      "children": [
                        {
                          "id": "deck-issue-thread",
                          "type": "block",
                          "size": {
                            "px": 40
                          },
                          "content": {
                            "mod": "deck",
                            "props": {
                              "view": "thread"
                            }
                          }
                        },
                        {
                          "id": "deck-issue-term",
                          "type": "block",
                          "content": {
                            "tab": "active",
                            "pane": {
                              "gap": 8,
                              "radius": 10,
                              "background": "background",
                              "lone": true,
                              "border": {
                                "width": 1,
                                "color": "raised"
                              },
                              "focus": {
                                "width": 1,
                                "color": "accent"
                              },
                              "header": {
                                "content": {
                                  "mod": "pane"
                                },
                                "height": 30,
                                "position": "top",
                                "reveal": "always"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "id": "deck-issue-gone",
                      "type": "block",
                      "content": {
                        "mod": "deck",
                        "props": {
                          "view": "issuegone"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "deck-issue-hints",
              "type": "block",
              "size": {
                "px": 36
              },
              "content": {
                "mod": "deck",
                "props": {
                  "view": "issuehints"
                }
              }
            }
          ]
        },
        {
          "id": "deck-terminal",
          "type": "row",
          "resizable": false,
          "divider": {
            "width": 1,
            "color": "raised"
          },
          "children": [
            {
              "id": "deck-term-side",
              "type": "column",
              "size": {
                "px": 268
              },
              "background": "chrome",
              "resizable": false,
              "children": [
                {
                  "id": "deck-term-spaces",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "spaces"
                  }
                },
                {
                  "id": "deck-term-machines",
                  "type": "block",
                  "size": {
                    "px": 120
                  },
                  "content": {
                    "mod": "deck",
                    "props": {
                      "view": "machines"
                    }
                  }
                },
                {
                  "id": "deck-term-agents",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "agents"
                  }
                },
                {
                  "id": "deck-term-hints",
                  "type": "block",
                  "size": {
                    "px": 52
                  },
                  "content": {
                    "mod": "deck",
                    "props": {
                      "view": "termhints"
                    }
                  }
                }
              ]
            },
            {
              "id": "deck-term-pane",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "raised"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
