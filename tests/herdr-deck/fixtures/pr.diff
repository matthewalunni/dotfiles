diff --git a/api/src/notes.test.ts b/api/src/notes.test.ts
new file mode 100644
index 0000000..8a9b0c1
--- /dev/null
+++ b/api/src/notes.test.ts
@@ -0,0 +1,15 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createNote } from "./notes";
+
+test("rejects an empty title", async () => {
+  await assert.rejects(createNote({ title: "" }), /needs a title/);
+});
+
+test("rejects a whitespace title", async () => {
+  await assert.rejects(createNote({ title: "   " }), /needs a title/);
+});
+
+test("trims the title", async () => {
+  assert.equal((await createNote({ title: "  hi " })).title, "hi");
+});
