{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Keeps Homebrew packages in step with the Brewfile on every `chezmoi apply`,
# so a new tool added to the repo shows up without re-running install.sh.
# Re-runs only when the Brewfile changes: {{ include "Brewfile" | sha256sum }}
set -euo pipefail

for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [ -x "$b" ] && eval "$("$b" shellenv)" && break
done
if ! command -v brew >/dev/null; then
  echo "chezmoi: Homebrew not found; run install.sh first (skipping brew bundle)" >&2
  exit 0
fi

# Never fail: this is a `before` script, so a non-zero exit aborts the whole
# apply and, since chezmoi only records success, every apply after it too.
if ! brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile"; then
  echo "chezmoi: brew bundle had failures (see above); dotfiles were still applied." >&2
  echo "chezmoi: a formula installed from another tap under the same name is the usual cause;" >&2
  # Exiting 0 marks this script done, so `chezmoi apply` won't retry it until
  # the Brewfile changes; point at the command that will.
  echo "chezmoi: \`brew uninstall <name>\`, then retry with: brew bundle --file={{ .chezmoi.sourceDir }}/Brewfile" >&2
fi
{{- end }}
