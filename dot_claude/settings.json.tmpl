{{- /*
  Generic Claude Code settings: only what this repo's own workflow needs.
  Personal preferences (model, plugins, marketplaces, voice, auto mode, ...)
  stay on your machine and are merged on top of this at apply time from:
    ~/.claude/settings.overrides.json   any settings keys, JSON object
    ~/.claude/automode.local.json       the "autoMode" value only
  Neither file is in this repo. Both are optional.
*/ -}}
{{- $s := dict
  "hooks" (dict "SessionStart" (list (dict
    "matcher" "*"
    "hooks" (list (dict
      "type" "command"
      "command" "f=\"$HOME/.claude/hooks/herdr-agent-state.sh\"; [ -f \"$f\" ] && bash \"$f\" session || true"
      "timeout" 10)))))
  "statusLine" (dict "type" "command" "command" "bash \"$HOME/.claude/statusline-command.sh\"")
-}}
{{- $overrides := joinPath .chezmoi.homeDir ".claude/settings.overrides.json" -}}
{{- if stat $overrides }}{{ $s = mergeOverwrite $s (include $overrides | fromJson) }}{{ end -}}
{{- $automode := joinPath .chezmoi.homeDir ".claude/automode.local.json" -}}
{{- if stat $automode }}{{ $s = mergeOverwrite $s (dict "autoMode" (include $automode | fromJson)) }}{{ end -}}
{{ toPrettyJson $s }}
